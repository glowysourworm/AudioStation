<Window x:Class="AudioStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioStation.Views"
        xmlns:controls="clr-namespace:AudioStation.Controls"
        xmlns:region="clr-namespace:SimpleWpf.IocFramework.RegionManagement;assembly=SimpleWpf.IocFramework"        
        xmlns:fa5assembly="clr-namespace:FontAwesome5;assembly=FontAwesome5"        
        WindowState="Minimized"
        WindowStartupLocation="CenterOwner"
        Title="Audio Station" Height="800" Width="1200"
        Icon="/Resources/Images/icon.bmp"
        IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Background -->
        <Grid Grid.RowSpan="4" 
              Grid.ColumnSpan="2"               
              DataContext="{Binding NowPlaying}">

            <!--controls:WebImageCarouselControl HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Interval="5000"
                                                  ImageSize="FullSize"                                      
                                                  Artwork="{Binding BackgroundImages, Mode=TwoWay}">
            </controls:WebImageCarouselControl-->

            <controls:WebImageControl HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Stretch="UniformToFill"
                                      StretchDirection="Both"
                                      ImageSize="FullSize"                                      
                                      ImageEndpoint="{Binding BestImage, Mode=TwoWay}">
                <controls:WebImageControl.Effect>
                    <BlurEffect Radius="100" />
                </controls:WebImageControl.Effect>
            </controls:WebImageControl>
        </Grid>

        <!-- Menu -->
        <Menu Grid.ColumnSpan="2" Background="White" BorderBrush="LightGray" BorderThickness="1">
            <MenuItem Header="_File" Style="{StaticResource UserMenuItemStyle}">
                <MenuItem Header="_Configuration" Style="{StaticResource UserMenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="_View" Style="{StaticResource UserMenuItemStyle}">
                <MenuItem x:Name="ShowLogButton" Header="_Show Log" Style="{StaticResource UserMenuItemStyle}" Click="ShowLogButton_Click" />
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource UserMenuItemStyle}">
                <MenuItem Header="_About" Style="{StaticResource UserMenuItemStyle}" />
            </MenuItem>            
        </Menu>

        <!-- Main View (Manager) / (Playlist) -->
        <region:IocRegion region:IocRegionManager.RegionName="MainRegion" Margin="5"
                          IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}"
                          Grid.ColumnSpan="2" Grid.Row="1" />
        
        <!-- Audio Control Panel: Equalizer, Volume -->
        <Border Grid.Column="1" 
                Grid.Row="1"
                IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Background="Transparent">
            <region:IocRegion region:IocRegionManager.DefaultViewType="{x:Type views:AudioControlPanelView}">
            </region:IocRegion>
        </Border>

        <!-- Playlist Controller (Panel) (Bound to MainViewModel -> (Playlist)) -->
        <Border x:Name="PlaylistControllerPanel" 
                IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding NowPlaying.Playlist.CurrentTrack, Converter={StaticResource NonNullVisibilityConverter}}"
                Background="Transparent" 
                BorderBrush="LightGray" 
                BorderThickness="1">
            <Grid>
                <region:IocRegion region:IocRegionManager.DefaultViewType="{x:Type views:PlayerControlView}"
                                  DataContext="{Binding NowPlaying.Playlist.CurrentTrack, Mode=TwoWay, NotifyOnSourceUpdated=True}">
                </region:IocRegion>
            </Grid>
        </Border>

        <!-- Status Bar (Footer) -->
        <Border x:Name="StatusBorder" Grid.Row="3" Grid.ColumnSpan="2" Background="#EEEEEE">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.AudioPlayerStatus}" BorderThickness="0 0 1 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Solid_Music}" Grid.Column="0" />

                <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" Style="{StaticResource LabelTextBlock}" Text="{Binding StatusViewModel.PrimaryMessage}" Grid.Column="1" />

                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.OutputControllerStatus}" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Regular_FileWord}" Grid.Column="2" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.AudioStationDbStatus}" BorderThickness="1 0 0 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Solid_Database}" Grid.Column="3" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.BandcampClient}" BorderThickness="1 0 0 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Brands_Bandcamp}" Grid.Column="4" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.AcoustIDClient}" BorderThickness="1 0 0 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Solid_IdBadge}" Grid.Column="5" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.DiscogsClient}" BorderThickness="1 0 0 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Solid_RecordVinyl}" Grid.Column="6" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.FanartClient}" BorderThickness="1 0 0 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Solid_Music}" Grid.Column="7" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.ITunesClient}" BorderThickness="1 0 0 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Brands_Itunes}" Grid.Column="8" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.LastFmClient}" BorderThickness="1 0 1 0" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Brands_Lastfm}" Grid.Column="9" />
                <Button ToolTip="{Binding Message}" DataContext="{Binding StatusViewModel.MusicBrainzClient}" Style="{StaticResource FontAwesomeStatusIcon}" Tag="{x:Static fa5assembly:EFontAwesomeIcon.Solid_Music}" Grid.Column="10" />

            </Grid>
        </Border>

    </Grid>
</Window>
