<Window x:Class="AudioStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioStation.Views"
        xmlns:controls="clr-namespace:AudioStation.Controls"
        xmlns:region="clr-namespace:SimpleWpf.IocFramework.RegionManagement;assembly=SimpleWpf.IocFramework"        
        xmlns:fa5assembly="clr-namespace:FontAwesome5;assembly=FontAwesome5"        
        WindowState="Minimized"
        WindowStartupLocation="CenterOwner"
        Title="Audio Station" 
        MinWidth="{StaticResource ScreenMinWidth}"
        MinHeight="{StaticResource ScreenMinHeight}"
        Width="{StaticResource ScreenMinWidth}"
        Height="{StaticResource ScreenMinHeight}"        
        Icon="/Resources/Images/icon.bmp"
        IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Background -->
        <Grid Grid.RowSpan="4" 
              Grid.ColumnSpan="2"               
              DataContext="{Binding NowPlaying}">

            <!--controls:WebImageCarouselControl HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Interval="5000"
                                                  ImageSize="FullSize"                                      
                                                  Artwork="{Binding BackgroundImages, Mode=TwoWay}">
            </controls:WebImageCarouselControl-->

            <!--controls:WebImageControl HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Stretch="UniformToFill"
                                      StretchDirection="Both"
                                      ImageSize="FullSize"                                      
                                      ImageEndpoint="{Binding StartImage, Mode=TwoWay}">
                <controls:WebImageControl.Effect>
                    <BlurEffect Radius="100" />
                </controls:WebImageControl.Effect>
            </controls:WebImageControl-->
        </Grid>

        <!-- Menu -->
        <Menu Grid.ColumnSpan="2" Background="White" BorderBrush="LightGray" BorderThickness="1">
            <MenuItem Header="_File" Style="{StaticResource UserMenuItemStyle}">
                <MenuItem Header="_Configuration" Style="{StaticResource UserMenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="_View" Style="{StaticResource UserMenuItemStyle}">
                <MenuItem x:Name="ShowLogButton" Header="_Show Log" Style="{StaticResource UserMenuItemStyle}" Click="ShowLogButton_Click" />
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource UserMenuItemStyle}">
                <MenuItem Header="_About" Style="{StaticResource UserMenuItemStyle}" />
            </MenuItem>            
        </Menu>

        <!-- Main View (Manager) / (Playlist) -->
        <region:IocRegion region:IocRegionManager.RegionName="MainRegion" Margin="5"
                          IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}"
                          Grid.ColumnSpan="2" Grid.Row="1" />
        
        <!-- Audio Control Panel: Equalizer, Volume -->
        <Border Grid.Column="1" 
                Grid.Row="1"
                IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Background="Transparent">
            <region:IocRegion region:IocRegionManager.DefaultViewType="{x:Type views:AudioControlPanelView}">
            </region:IocRegion>
        </Border>

        <!-- Playlist Controller (Panel) (Bound to MainViewModel -> (Playlist)) -->
        <Border x:Name="PlaylistControllerPanel" 
                IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding NowPlayingPlaylist.CurrentTrack, Converter={StaticResource NonNullVisibilityConverter}}"
                Background="Transparent" 
                BorderBrush="LightGray" 
                BorderThickness="1">
            <Grid>
                <region:IocRegion region:IocRegionManager.DefaultViewType="{x:Type views:PlayerControlView}"
                                  DataContext="{Binding NowPlayingPlaylist.CurrentTrack}">
                </region:IocRegion>
            </Grid>
        </Border>

        <!-- Status Bar (Footer) -->
        <Border x:Name="StatusBorder" Grid.Row="3" Grid.ColumnSpan="2" Background="#EEEEEE">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.AudioPlayerStatus}"
                                                  IconType="AudioStation"                                    
                                                  Width="22"
                                                  Height="22"
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />
                
                <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" Style="{StaticResource LabelTextBlock}" Text="{Binding StatusViewModel.PrimaryMessage}" Grid.Column="1" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.OutputControllerStatus}"
                                                  Grid.Column="2"
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="AudioStationLog"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.AudioStationDbStatus}"
                                                  Grid.Column="3"                         
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="Database"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.AcoustIDClient}"
                                                  Grid.Column="4"                
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="AcoustID"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.DiscogsClient}"
                                                  Grid.Column="5"
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="Discogs"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.FanartClient}"
                                                  Grid.Column="6"
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="Fanart"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.ITunesClient}"
                                                  Grid.Column="7"                                                  
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="iTunes"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.LastFmClient}"
                                                  Grid.Column="8"
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="LastFm"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

                <controls:AudioStationIconControl DataContext="{Binding StatusViewModel.MusicBrainzClient}"
                                                  Grid.Column="9"
                                                  Style="{StaticResource AudioStationStatusIcon}"
                                                  IconType="MusicBrainz"  
                                                  IconState="{Binding IconState}" 
                                                  ActivityBadgeCount="{Binding ActivityBadgeCount}" 
                                                  ToolTip="{Binding Message}" />

            </Grid>
        </Border>

    </Grid>
</Window>
