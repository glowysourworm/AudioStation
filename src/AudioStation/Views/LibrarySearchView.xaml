<UserControl x:Class="AudioStation.Views.LibrarySearchView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:local="clr-namespace:AudioStation.Views"
             xmlns:controls="clr-namespace:AudioStation.Controls"
             xmlns:controlAnimation="clr-namespace:AudioStation.Controls.Animation"             
             xmlns:views="clr-namespace:AudioStation.Views"
             xmlns:viewBehavior="clr-namespace:AudioStation.Views.Behavior"
             xmlns:behavior="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"             
             xmlns:libraryViewModel="clr-namespace:AudioStation.ViewModels.LibraryViewModels"
             xmlns:cacheModel="AudioStation.Core.Controller.ImageCacheModel;assembly=AudioStation.Core"
             xmlns:region="clr-namespace:SimpleWpf.IocFramework.RegionManagement;assembly=SimpleWpf.IocFramework"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:sys="clr-namespace:System;assembly=System.Core"
             DataContext="{Binding LibrarySearch}"
             Background="White">

    <Grid RowDefinitions="Auto, *">

        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="280" MaxWidth="550" Width="*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        
        <!-- Library Entity Search -->
        <Border Padding="5"
                CornerRadius="5"
                BorderBrush="LightGray"
                BorderThickness="1">
            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">

                <!-- Search Text -->
                <propertyGrid:PropertyStringControl Grid.ColumnSpan="2"
                                                    Grid.Row="0"
                                                    LabelText="Search"
                                                    LabelColumnWidth="100"
                                                    IsRequired="False"
                                                    Style="{StaticResource PropertyGridUserControl}"
                                                    Value="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />                
                
                <!-- Search Type -->
                <propertyGrid:PropertyEnumControl Grid.ColumnSpan="2"
                                                  Grid.Row="1"
                                                  EnumType="{x:Type libraryViewModel:LibrarySearchType}"
                                                  LabelText="Search Field"
                                                  LabelColumnWidth="100"
                                                  Style="{StaticResource PropertyGridUserControl}"
                                                  Value="{Binding SearchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Search Page Information -->                    
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelDetailTextBlock}" Grid.Row="2" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Search Results" Style="{StaticResource LabelDetailTextBlock}" Margin="3" />
                        <TextBlock Text="{Binding TotalArtistFilteredCount}" Style="{StaticResource LabelDetailTextBlock}" Margin="3"/>
                        <TextBlock Text=" of " Style="{StaticResource LabelDetailTextBlock}" Margin="3" />
                        <TextBlock Text="{Binding TotalArtistCount}" Style="{StaticResource LabelDetailTextBlock}" Margin="3"/>
                    </StackPanel>
                </TextBlock>
                
            </Grid>
        </Border>

        <!-- Library Search Results -->
        <ListBox x:Name="ResultsLB" 
                 SelectionChanged="ResultsLB_SelectionChanged"
                 MouseDoubleClick="ResultsLB_MouseDoubleClick"
                 Grid.Row="1"
                 ItemsSource="{Binding SearchCollection}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.IsContainerVirtualizable="True"
                 VirtualizingPanel.CacheLength="3"
                 VirtualizingPanel.ScrollUnit="Item"                     
                 HorizontalContentAlignment="Stretch"
                 ItemContainerStyle="{StaticResource HoverSelectItemContainerStyleWithAlternation}"
                 AlternationCount="2"
				 Background="White"
				 BorderBrush="LightGray"
				 BorderThickness="1">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Albums (Preview) -->
                        <!--fa5:SvgAwesome Icon="Solid_CompactDisc" Style="{StaticResource FontAwesomeIconDefault}" /-->

                        <!-- Artist -->
                        <Border  Grid.Column="0">
                            <TextBlock Text="{Binding Artist}"
                                           Style="{StaticResource LabelTextBlock}" 
                                           Margin="5">
                            </TextBlock>
                        </Border>

                        <!-- Album Count -->
                        <TextBlock Style="{StaticResource LabelDetailTextBlock}" 
                                       Grid.Column="1" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Right"
                                       Margin="5">
                                <Run Text="{Binding Albums.Count, Mode=OneWay}" />
                                <Run Text=" Albums" />
                        </TextBlock>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Album Detail (List of Album Details) -->
        <ListBox x:Name="AlbumDetailLB" Grid.Column="1" Grid.RowSpan="2"
                 ItemsSource="{Binding SelectedItem.Albums, ElementName=ResultsLB}"                 
                 VirtualizingPanel.IsVirtualizing="False"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="AlbumDetailLB_MouseDoubleClick"
                 PreviewMouseWheel="AlbumDetailLB_PreviewMouseWheel"
                 ItemContainerStyle="{StaticResource TransparentItemContainerStyle}"                 
				 BorderBrush="LightGray" BorderThickness="0,1,1,1">
            <behavior:Interaction.Behaviors>
                <viewBehavior:ListBoxResponsiveBehavior />
            </behavior:Interaction.Behaviors>
        </ListBox>

    </Grid>
</UserControl>
