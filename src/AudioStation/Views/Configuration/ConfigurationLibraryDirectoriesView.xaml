<UserControl x:Class="AudioStation.Views.Configuration.ConfigurationLibraryDirectoriesView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:local="clr-namespace:AudioStation.Views"
             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:simpleUI="clr-namespace:SimpleWpf.UI.Controls;assembly=SimpleWpf.UI"
             xmlns:enumUI="clr-namespace:SimpleWpf.UI.Controls.EnumUI;assembly=SimpleWpf.UI"
             xmlns:coreModel="clr-namespace:AudioStation.Core.Model;assembly=AudioStation.Core"
             Background="White">

    <Grid>
        <DataGrid x:Name="LibraryFoldersDG" 
                  Style="{StaticResource LibraryFoldersDataGridStyle}"
                  VerticalAlignment="Top"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay, ElementName=BaseControl}"
                  IsReadOnly="{Binding ConfigurationLocked, ElementName=BaseControl}"
                  ItemsSource="{Binding ItemsSource, ElementName=BaseControl}">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Label" Binding="{Binding DirectoryLabel}" Width="140" CellStyle="{StaticResource ManagerDataGridCellStyle}" />
                <DataGridTextColumn Header="Directory" IsReadOnly="True"  
                                                Binding="{Binding Directory}" Width="*" CellStyle="{StaticResource ManagerDataGridCellStyle}" />

                <DataGridTemplateColumn Header="Primary" Width="Auto" CellStyle="{StaticResource ManagerDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="IsPrimary" HorizontalAlignment="Center" IsChecked="{Binding IsPrimary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Type" Width="120" CellStyle="{StaticResource ManagerDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <enumUI:SimpleEnumComboBox EnumType="{x:Type coreModel:TrackType}" 
                                                               EnumValue="{Binding TrackType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               IsEnabled="{Binding ConfigurationLocked, Converter={StaticResource BoolInverseConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Naming" Width="140" CellStyle="{StaticResource ManagerDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <enumUI:SimpleEnumComboBox EnumType="{x:Type coreModel:TrackNamingType}" 
                                                               EnumValue="{Binding NamingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               IsEnabled="{Binding ConfigurationLocked, Converter={StaticResource BoolInverseConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Grouping" Width="180" CellStyle="{StaticResource ManagerDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <enumUI:SimpleEnumComboBox EnumType="{x:Type coreModel:TrackGroupingType}" 
                                                               EnumValue="{Binding GroupingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               IsEnabled="{Binding ConfigurationLocked, Converter={StaticResource BoolInverseConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn CellStyle="{StaticResource ManagerDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding OpenFolderCommand}" 
                                                Style="{StaticResource SmallControlButton}"
                                                IsEnabled="{Binding ConfigurationLocked, Converter={StaticResource BoolInverseConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                <fa5:SvgAwesome Icon="Regular_FolderOpen" Height="16" Width="16" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>        
    </Grid>
</UserControl>
