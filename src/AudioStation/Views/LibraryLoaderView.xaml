<UserControl x:Class="AudioStation.Views.LibraryLoaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <Border Background="{StaticResource HeaderBackground}" Margin="0" Padding="3" BorderBrush="Transparent" BorderThickness="0">
            <Grid ColumnDefinitions="*, 200, Auto">
                
                <!-- Loader Task Name-->
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource HeaderMediumTextBlock}" Margin="5" VerticalAlignment="Center" />
                
                <!-- Loader Tasks -->
                <ComboBox x:Name="LoaderTaskCB" ItemsSource="{Binding LoaderTasks}" SelectedIndex="0" DisplayMemberPath="DisplayName" Grid.Column="1" Margin="5 5 0 5" />
                
                <!-- Control Buttons -->
                <Button Style="{StaticResource UserControlButton}" Command="{Binding SelectedItem.ExecuteCommand, ElementName=LoaderTaskCB}" Grid.Column="2" HorizontalAlignment="Right" Margin="5">
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Execute" Style="{StaticResource LabelTextBlock}" Margin="3" FontSize="12" />
                        <fa5:SvgAwesome Icon="Solid_Play" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <Grid Grid.Row="1" ColumnDefinitions="Auto, *">
            
            <GroupBox Header="Work Item Status" Style="{StaticResource TagIssuesGroupBoxStyle}" Grid.Row="1">
                <StackPanel>
                    <propertyGrid:PropertyLabelControl LabelColumnWidth="140" LabelText="Waiting" Value="{Binding SelectedItem.WorkItemsWaiting, ElementName=LoaderTaskCB}" />
                    <propertyGrid:PropertyLabelControl LabelColumnWidth="140" LabelText="In Progress" Value="{Binding SelectedItem.WorkItemsInProgress, ElementName=LoaderTaskCB}" />
                    <propertyGrid:PropertyLabelControl LabelColumnWidth="140" LabelText="Completed (success)" Value="{Binding SelectedItem.WorkItemsSuccessful, ElementName=LoaderTaskCB}" />
                    <propertyGrid:PropertyLabelControl LabelColumnWidth="140" LabelText="Completed (error)" Value="{Binding SelectedItem.WorkItemsError, ElementName=LoaderTaskCB}" />
                    <propertyGrid:PropertyLabelControl LabelColumnWidth="140" LabelText="Total" Value="{Binding SelectedItem.WorkItems.Count, ElementName=LoaderTaskCB}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Selected Log Messages" Grid.Column="1">
                <ListBox Grid.Column="1"
                         Margin="0"
                         Style="{StaticResource PlainListBoxStyle}"
                         ItemContainerStyle="{StaticResource HoverSelectItemContainerStyleWithAlternation}"
                         AlternationCount="2"
                         DisplayMemberPath="Message"
                         ItemsSource="{Binding ElementName=WorkItemLB, Path=SelectedItem.LogMessages}" />
            </GroupBox>
        </Grid>


        <!-- Input Files -->
        <ListBox x:Name="WorkItemLB"
                 ItemsSource="{Binding SelectedItem.WorkItems, ElementName=LoaderTaskCB}"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Grid.Row="2"
                 Margin="0"                 
                 ItemTemplate="{StaticResource LibraryWorkItemDataTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 HorizontalContentAlignment="Stretch">
        </ListBox>
    </Grid>
</UserControl>