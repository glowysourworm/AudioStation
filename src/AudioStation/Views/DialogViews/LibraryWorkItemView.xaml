<UserControl x:Class="AudioStation.Views.DialogViews.LibraryWorkItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             Width="700" Height="180">

    <TabControl>
        <TabItem Header="Properties">
            
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" Grid.Row="1"
                                           LabelText="Name"
                                           Style="{StaticResource PropertyGridUserControl}"
                                           Value="{Binding Load.DisplayName}" />

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" Grid.Row="2"                                
                                           LabelText="Status"
                                           Style="{StaticResource PropertyGridUserControl}"
                                           Value="{Binding State}" />

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" Grid.Row="3"                                
                                           LabelText="Last Message"
                                           Style="{StaticResource PropertyGridUserControl}"
                                           Value="{Binding LastMessage}" />

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" Grid.Row="4"                                
                                           LabelText="Error Status"
                                           Style="{StaticResource PropertyGridUserControl}"
                                           Value="{Binding ErrorLevel}" />
            </Grid>
        </TabItem>

        <TabItem Header="Work Steps" IsEnabled="{Binding WorkSteps, Converter={StaticResource CollectionNonEmptyBoolConverter}}">
            <ListBox ItemsSource="{Binding WorkSteps}"
                     Style="{StaticResource PlainListBoxStyle}"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource HoverSelectItemContainerStyle}"
                     ItemTemplate="{StaticResource LibraryWorkStepItemTemplate}">
            </ListBox>
        </TabItem>

        <TabItem Header="Log" IsEnabled="{Binding LogMessages, Converter={StaticResource CollectionNonEmptyBoolConverter}}">
            <ListBox ItemsSource="{Binding LogMessages}"
                     ItemTemplate="{StaticResource LogDataTemplate}"
                     Style="{StaticResource PlainListBoxStyle}">
            </ListBox>
        </TabItem>
        
    </TabControl>

    
</UserControl>
