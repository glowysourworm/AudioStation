<UserControl x:Class="AudioStation.Views.DialogViews.NamingGroupingFormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioStation.Controls"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             Width="640">
    <Grid Margin="10" RowDefinitions="Auto, Auto, Auto, Auto">
        
        <!-- Format -->
        <propertyGrid:PropertyStringControl Style="{StaticResource PropertyGridDetailUserControl}"
                                            LabelColumnWidth="160"
                                            LabelText="{Binding LabelText}"
                                            Description="{Binding Description}"
                                            IsReadOnly="False"
                                            IsRequired="True"
                                            Value="{Binding Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Usage -->
        <propertyGrid:PropertyLabelControl Style="{StaticResource PropertyGridDetailUserControl}"
                                           Grid.Row="1"
                                           TextWrap="Wrap"
                                           LabelColumnWidth="160"
                                           LabelText="Usage"
                                           IsReadOnly="True"
                                           IsRequired="False"
                                           Value="{Binding Usage}" />

        <!-- User Output -->
        <propertyGrid:PropertyStringControl Style="{StaticResource PropertyGridDetailUserControl}"
                                            Grid.Row="2"
                                            LabelColumnWidth="160"
                                            LabelText="Example Format"
                                            IsReadOnly="True"
                                            IsRequired="False"
                                            Description="{Binding UserOutputDescription}"
                                            Value="{Binding UserOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Keywords -->
        <controls:NoSelectListBox ItemsSource="{Binding Format.Fields, Mode=OneWay}" 
                                  Style="{StaticResource PlainListBoxStyle}"
                                  BorderBrush="LightGray"
                                  BorderThickness="1"
                                  AlternationCount="2"
                                  ItemContainerStyle="{StaticResource NoHoverSelectItemContainerStyleWithAlteration}"
                                  Grid.Row="3">
            <controls:NoSelectListBox.ItemTemplate>
                <DataTemplate>
                    <propertyGrid:PropertyLabelControl Style="{StaticResource PropertyGridDetailUserControl}"
                                                       Margin="0"
                                                       ToolTip="{Binding Description}"
                                                       LabelColumnWidth="160"
                                                       LabelText="{Binding Name}"
                                                       Value="{Binding TokenName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </controls:NoSelectListBox.ItemTemplate>
        </controls:NoSelectListBox>
       
    </Grid>
</UserControl>
