<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportTagCompletionView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:controls="clr-namespace:AudioStation.Controls"
             xmlns:importView="clr-namespace:AudioStation.Views.LibraryImportViews"
             xmlns:coreModel="clr-namespace:AudioStation.Core.Model;assembly=AudioStation.Core"
             xmlns:viewModel="clr-namespace:AudioStation.ViewModels.LibraryLoaderViewModels"
             xmlns:viewModelImport="clr-namespace:AudioStation.ViewModels.LibraryImporterViewModels.Import"
             xmlns:simpleUI="clr-namespace:SimpleWpf.UI.Controls;assembly=SimpleWpf.UI">
    
    <Grid RowDefinitions="Auto, *, *, Auto">
        
        <!-- Staged Files (in memory) -->
        <xceed:WatermarkTextBox Margin="5" 
                                Grid.ColumnSpan="2"
                                Text="{Binding SourceFolderSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                Watermark="Search Staged Files..." 
                                HorizontalAlignment="Stretch" />

        <!-- Input Files -->
        <ListBox x:Name="StagedFileLB"
                 ItemsSource="{Binding StagedFiles}"
                 Grid.Column="0"
                 Grid.Row="1"
                 Margin="5"                 
                 ItemTemplate="{StaticResource LibraryImportFileItemTemplate}"
                 ItemContainerStyle="{StaticResource LibraryImportFileItemContainerStyle}"
                 SelectionMode="Single"
                 AlternationCount="2"
                 HorizontalContentAlignment="Stretch"                 
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="3">

        </ListBox>
        
        <!-- Detail Panel:  SelectedItem.File (LibraryImportFileViewModel) -->
        <TabControl Grid.Row="2" Grid.RowSpan="1"
                    DataContext="{Binding SelectedItem.File, ElementName=StagedFileLB}">

            <!-- Import Detail / Control Panel -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Status" Style="{StaticResource LabelTextBlock}" />
                </TabItem.Header>
                
                <!-- Tag:  LibraryImporterViewModel -->
                <importView:LibraryImportTagControlPanel Tag="{Binding DataContext, ElementName=BaseControl}" />
            </TabItem>
            
            
            <!-- Import Detail / File Properties -->
            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="Auto, Auto">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Source File (" Style="{StaticResource LabelTextBlock}" />
                            <TextBlock Text="{Binding LastWriteUtc}" Style="{StaticResource LabelTextBlock}" />
                            <TextBlock Text=")" Style="{StaticResource LabelTextBlock}" />
                        </StackPanel>
                        
                    </Grid>
                </TabItem.Header>
                <importView:LibraryImportFileDetailView />
            </TabItem>

            <!-- Tag Detail (Save / Clear / Music Brainz) -->
            <TabItem>
                <TabItem.Header>

                    <!-- Control Panel -->
                    <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" Margin="3" 
                                    VerticalAlignment="Center"
                                    Grid.Column="1">


                        <fa5:ImageAwesome Icon="Solid_Tag" 
                                          Margin="3"
                                          Style="{StaticResource FontAwesomeIconManagerViewPager}"
                                          ToolTip="Tag data is required to complete the import">
                            <fa5:ImageAwesome.Foreground>
                                <MultiBinding Converter="{StaticResource LibraryLoaderImportTagForegroundConverter}">
                                    <Binding Path="IsTagDirty" />
                                    <Binding Path="MinimumImportValid" />
                                    <Binding Path="InError" />
                                </MultiBinding>
                            </fa5:ImageAwesome.Foreground>
                        </fa5:ImageAwesome>

                        <TextBlock Text="Tag Import" Style="{StaticResource LabelTextBlock}" />

                        <!-- Copy Music Brainz -> Tag -->
                        <Button Style="{StaticResource UserControlButton}" 
                                Command="{Binding CopyMusicBrainzToTagCommand}"
                                ToolTip="Copy Music Brainz Data To Tag"
                                Visibility="{Binding ImportOutput.MusicBrainzRecordingMatchSuccess, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                Margin="5 0 0 0">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Copy" Margin="3 1" FontSize="12" />
                                <fa5:ImageAwesome Icon="Solid_Music" 
                                                  Style="{StaticResource FontAwesomeIconManagerViewPager}" 
                                                  Margin="1" />
                            </StackPanel>
                        </Button>

                        <!-- Save Tag -->
                        <Button Style="{StaticResource UserControlButton}" 
                                    Command="{Binding SaveTagCommand}"
                                    ToolTip="Save Tag To Disk"
                                    Visibility="{Binding IsTagDirty, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                    Margin="5 0 0 0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Save" Margin="3 1" FontSize="12" />
                                <fa5:ImageAwesome Icon="Solid_Save" 
                                                      Style="{StaticResource FontAwesomeIconManagerViewPager}" 
                                                      Margin="1" />
                            </StackPanel>
                        </Button>

                        <!-- Clear Tag (Revert) -->
                        <Button Style="{StaticResource UserControlButton}" 
                                Command="{Binding RefreshCommand}"
                                Visibility="{Binding IsTagDirty, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                ToolTip="Clear All Imported Data And Restart"
                                Margin="5 0 0 0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Clear" Margin="3 1" FontSize="12" />
                                <fa5:ImageAwesome Icon="Solid_Recycle" 
                                                      Style="{StaticResource FontAwesomeIconManagerViewPager}" 
                                                      Margin="1" />
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </TabItem.Header>

                <!-- Tag Detail -->
                <Grid ColumnDefinitions="*, *">
                    <!-- Tag (Clean / Dirty) -->
                    <importView:LibraryImportTagIssuesView DataContext="{Binding Tag}">
                        <importView:LibraryImportTagIssuesView.TagHeader>
                            <TextBlock Text="Source File" Style="{StaticResource TagLabelTextBlock}" />
                        </importView:LibraryImportTagIssuesView.TagHeader>
                    </importView:LibraryImportTagIssuesView>

                    <!-- Music Brainz Tag -->
                    <importView:LibraryImportTagIssuesView DataContext="{Binding Tag}" Grid.Column="1">
                        <importView:LibraryImportTagIssuesView.TagHeader>
                            <TextBlock Text="Music Brainz" Style="{StaticResource TagLabelTextBlock}" />
                        </importView:LibraryImportTagIssuesView.TagHeader>                        
                    </importView:LibraryImportTagIssuesView>
                </Grid>
            </TabItem>
        </TabControl>

            <!-- Control Panel -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="5">

            <TextBlock Style="{StaticResource LabelTextBlock}" Margin="10">
                <Run Text="Files to Run / Files Total:  " />
                <Run Text="{Binding SourceFileSelectedCount, Mode=OneWay}" />                
                <Run Text=" / " />
                <Run Text="{Binding SourceFileCount, Mode=OneWay}" />
            </TextBlock>

            <!-- Edit Tag(s) -->
            <Button Margin="0 5 5 0" 
                    Style="{StaticResource UserControlButton}" 
                    Command="{Binding EditTagCommand}"
                    Visibility="{Binding EditTagCommand.IsReady, Converter={StaticResource BoolVisibilityCollapseConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Edit Tag" Style="{StaticResource LabelTextBlock}" Margin="5" />
                    <fa5:SvgAwesome Icon="Solid_Tag" Style="{StaticResource FontAwesomeIconDefault}" Margin="5" />
                </StackPanel>
            </Button>

            <!-- Run AcoustID / Music Brainz -->
            <Button Margin="0 5 5 0" 
                    Style="{StaticResource UserControlButton}"
                    Command="{Binding RunAcousticFingerprintCommand}"
                    Visibility="{Binding RunAcousticFingerprintCommand.IsReady, Converter={StaticResource BoolVisibilityCollapseConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Run Acoustic Fingerprint " Style="{StaticResource LabelTextBlock}" Margin="5" />
                    <fa5:SvgAwesome Icon="Solid_Music" Style="{StaticResource FontAwesomeIconDefault}" Margin="5" />
                </StackPanel>
            </Button>

            <!-- Import -->
            <Button Margin="0 5 5 0" 
                    Style="{StaticResource UserControlButton}"
                    Command="{Binding RunImportCommand}"
                    Visibility="{Binding RunImportCommand.IsReady, Converter={StaticResource BoolVisibilityCollapseConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Import (Detail)" Style="{StaticResource LabelTextBlock}" Margin="5" />
                    <fa5:SvgAwesome Icon="Solid_Database" Style="{StaticResource FontAwesomeIconDefault}" Margin="5" />
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
