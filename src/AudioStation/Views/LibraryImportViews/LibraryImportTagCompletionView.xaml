<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportTagCompletionView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:controls="clr-namespace:AudioStation.Controls"
             xmlns:importView="clr-namespace:AudioStation.Views.LibraryImportViews"
             xmlns:coreModel="clr-namespace:AudioStation.Core.Model;assembly=AudioStation.Core"
             xmlns:simpleUI="clr-namespace:SimpleWpf.UI.Controls;assembly=SimpleWpf.UI">
    
    <Grid RowDefinitions="Auto, *, Auto, 250" ColumnDefinitions="*, Auto">

        <!-- Staged Files (in memory) -->
        <xceed:WatermarkTextBox Margin="5" 
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding SourceFolderSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                Watermark="Search Staged Files..." 
                                HorizontalAlignment="Stretch" />

        <!-- Control Panel (File Buttons) -->
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0">
            <Button Style="{StaticResource UserControlButton}" Grid.Column="2" Grid.Row="0" Margin="3" HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                Command="{Binding Tag.EditTagCommand, ElementName=BaseControl}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tag(s)" Margin="3" Style="{StaticResource LabelTextBlock}" FontSize="12" />
                    <fa5:SvgAwesome Icon="Solid_Tag" Style="{StaticResource FontAwesomeIconDefault}" Height="12" Width="12" Margin="3" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource UserControlButton}" Grid.Column="2" Grid.Row="1" Margin="3" HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding SelectedAcoustIDResult}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Acoust ID" Margin="3" Style="{StaticResource LabelTextBlock}" FontSize="12" />
                    <fa5:SvgAwesome Icon="Solid_VolumeUp" Style="{StaticResource FontAwesomeIconDefault}" Height="12" Width="12" Margin="3" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource UserControlButton}" Grid.Column="2" Grid.Row="2" Margin="3" HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding SelectedMusicBrainzRecordingMatch}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Music Brainz" Margin="3" Style="{StaticResource LabelTextBlock}" FontSize="12" />
                    <fa5:SvgAwesome Icon="Solid_Music" Style="{StaticResource FontAwesomeIconDefault}" Height="12" Width="12" Margin="3" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Import -->
            <Button Margin="3" 
                    Style="{StaticResource UserControlButton}" VerticalAlignment="Center"
                    Command="{Binding RunImportCommand}"
                    Visibility="{Binding RunImportCommand.IsReady, Converter={StaticResource BoolVisibilityCollapseConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Import" Style="{StaticResource LabelTextBlock}" FontSize="12" Margin="3" />
                    <fa5:SvgAwesome Icon="Solid_Database" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Input Files -->
        <ListBox x:Name="StagedFileLB"
                 ItemsSource="{Binding StagedFiles}"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Grid.Row="1"
                 Margin="5 0"                 
                 ItemTemplate="{StaticResource LibraryImportFileItemTemplate}"
                 ItemContainerStyle="{StaticResource LibraryImportFileItemContainerStyle}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 HorizontalContentAlignment="Stretch"                 
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="3">

        </ListBox>


        <!-- Status Panel -->
        <Border Grid.Row="2" 
                Grid.ColumnSpan="2" 
                BorderBrush="LightGray" 
                Background="#0F000000"
                BorderThickness="1 0 1 1" 
                Margin="5 0 5 5">
            
            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" HorizontalAlignment="Stretch">

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Margin="3">
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="Staged Files (" Margin="5 0 0 0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="{Binding StagedFiles.Count, Mode=OneWay}" Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text=" of " Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="{Binding SourceFileCount, Mode=OneWay}" Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text=")" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="3" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="Selected (" Margin="5 0 0 0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="{Binding SourceFileSelectedCount, Mode=OneWay}" Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text=")" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="3">
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="AcoustID (" Margin="5 0 0 0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="{Binding AcoustIDCompletedSuccessfully.Count, Mode=OneWay}" Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text=")" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="3">
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="Music Brainz (" Margin="5 0 0 0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="{Binding MusicBrainzCompletedSuccessfully.Count, Mode=OneWay}" Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text=")" Margin="0" />
                </StackPanel>
                
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="3">
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="Ready to Import (" Margin="5 0 0 0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text="{Binding FilesReadyToImport.Count, Mode=OneWay}" Margin="0" />
                    <TextBlock Style="{StaticResource LabelDetailDarkTextBlock}" Text=")" Margin="0" />
                </StackPanel>
            </Grid>
            

        </Border>

        <!-- Detail Panel:  SelectedItem.File (LibraryImportFileViewModel) -->
        <TabControl Grid.Row="3" Grid.RowSpan="1" Grid.ColumnSpan="2" Margin="5"
                    DataContext="{Binding SelectedItem, ElementName=StagedFileLB}">

            <!-- Import Detail / Configuration (Small) -->
            <TabItem Header="Configuration" Style="{StaticResource SimpleTabItemStyle}">
                <importView:LibraryImportSmallConfigurationView />
            </TabItem>
            
            <!-- Import Detail / Control Panel -->
            <TabItem Header="Status" Style="{StaticResource SimpleTabItemStyle}">
                
                <!-- Setting View's Tag:  LibraryImporterViewModel -->
                <importView:LibraryImportTagControlPanel Tag="{Binding DataContext, ElementName=BaseControl}" MinHeight="150"  />
            </TabItem>

            <!-- Import Detail / Log -->
            <TabItem Header="Log Messages" Style="{StaticResource SimpleTabItemStyle}">
                <ListBox AlternationCount="2"
                         ItemContainerStyle="{StaticResource PlainItemContainerStyleWithAlternation_AliceBlue}"
                         ItemsSource="{Binding ImportOutput.LogMessages}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource LabelTextBlock}" Margin="3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>


            <!-- Import Detail / File Properties -->
            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="Auto, Auto">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Source File" Style="{StaticResource LabelTextBlock}" />
                            <TextBlock Text="*" Style="{StaticResource LabelDetailDarkTextBlock}" VerticalAlignment="Center"
                                       Visibility="{Binding IsTagDirty, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                       />
                            <TextBlock Text="  (" Style="{StaticResource LabelDetailDarkTextBlock}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LastWriteUtc}" Style="{StaticResource LabelDetailDarkTextBlock}" VerticalAlignment="Center" />
                            <TextBlock Text=")" Style="{StaticResource LabelDetailDarkTextBlock}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </TabItem.Header>
                <importView:LibraryImportFileDetailView />
            </TabItem>

            <!-- Tag Detail (Save / Clear / Music Brainz) -->
            <TabItem>
                <TabItem.Header>

                    <!-- Control Panel -->
                    <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" Margin="3" 
                                    VerticalAlignment="Center"
                                    Grid.Column="1">

                        <fa5:ImageAwesome Icon="Solid_Tag" 
                                          Margin="3"
                                          Style="{StaticResource FontAwesomeIconManagerViewPager}"
                                          ToolTip="Tag data is required to complete the import">
                            <fa5:ImageAwesome.Foreground>
                                <MultiBinding Converter="{StaticResource LibraryLoaderImportTagForegroundConverter}">
                                    <Binding Path="IsTagDirty" />
                                    <Binding Path="MinimumImportValid" />
                                    <Binding Path="InError" />
                                </MultiBinding>
                            </fa5:ImageAwesome.Foreground>
                        </fa5:ImageAwesome>

                        <TextBlock Text="Tag Import" Style="{StaticResource LabelTextBlock}" />

                        <!-- Save Tag -->
                        <Button Style="{StaticResource UserControlButton}" 
                                    Command="{Binding SaveTagCommand}"
                                    ToolTip="Save Tag To Disk"
                                    Visibility="{Binding IsTagDirty, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                    Margin="5 0 0 0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Save" Margin="3 1" FontSize="12" />
                                <fa5:ImageAwesome Icon="Solid_Save" 
                                                  Style="{StaticResource FontAwesomeIconManagerViewPager}" 
                                                  Margin="1" />
                            </StackPanel>
                        </Button>

                        <!-- Clear Tag (Revert) -->
                        <Button Style="{StaticResource UserControlButton}" 
                                Command="{Binding RefreshCommand}"
                                Visibility="{Binding IsTagDirty, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                ToolTip="Clear All Imported Data And Restart"
                                Margin="5 0 0 0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Clear" Margin="3 1" FontSize="12" />
                                <fa5:ImageAwesome Icon="Solid_Recycle" 
                                                  Style="{StaticResource FontAwesomeIconManagerViewPager}" 
                                                  Margin="1" />
                            </StackPanel>

                        </Button>
                    </StackPanel>
                </TabItem.Header>

                <!-- Tag Detail -->
                <Grid ColumnDefinitions="*, Auto, *">

                    <!-- Tag (Clean / Dirty) -->
                    <importView:LibraryImportTagIssuesView DataContext="{Binding Tag}">
                        <importView:LibraryImportTagIssuesView.TagHeader>
                            <TextBlock Text="Source File" Style="{StaticResource TagLabelTextBlock}" />
                        </importView:LibraryImportTagIssuesView.TagHeader>
                    </importView:LibraryImportTagIssuesView>

                    <!-- Copy Music Brainz -> Tag -->
                    <Button Style="{StaticResource UserControlButton}" 
                            Command="{Binding CopyMusicBrainzToTagCommand}"
                            ToolTip="Copy Music Brainz Data To Tag"
                            Visibility="{Binding ImportOutput.MusicBrainzRecordingMatchSuccess, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                            Grid.Column="1"
                            Height="36"
                            Width="36"
                            Margin="5">

                        <fa5:ImageAwesome Icon="Solid_ArrowLeft" 
                                              Style="{StaticResource FontAwesomeIconManagerViewPager}" 
                                              Margin="1" />
                    </Button>

                    <!-- Music Brainz Tag -->
                    <importView:LibraryImportTagIssuesView DataContext="{Binding MusicBrainzTag}" Grid.Column="2">
                        <importView:LibraryImportTagIssuesView.TagHeader>
                            <TextBlock Text="Music Brainz" Style="{StaticResource TagLabelTextBlock}" />
                        </importView:LibraryImportTagIssuesView.TagHeader>
                    </importView:LibraryImportTagIssuesView>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
