<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportLoaderView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:controls="clr-namespace:AudioStation.Controls">

    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, *" DataContext="{Binding Loader}">

        <!-- Loader Tasks (workflow) -->
        <ListBox x:Name="LoaderLB"
                 SelectedIndex="0"
                 Grid.Column="0"
                 Grid.RowSpan="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemTemplate="{StaticResource LibraryImporterWorkflowItemTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}">
        </ListBox>
        
        <!-- Input Files -->
        <ListBox x:Name="LoaderWorkItemsLB"
                 ItemsSource="{Binding SelectedItem.WorkItems, ElementName=LoaderLB}"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Grid.Row="2"
                 Margin="0"                 
                 ItemTemplate="{StaticResource LibraryWorkItemDataTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 HorizontalContentAlignment="Stretch">
        </ListBox>

        <!-- PROCESSING:  Execute, Pause, Canel -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource HeaderBackground}">

            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto"
                  Margin="5"
                  IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}">

                <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=LoaderLB}" Margin="5" />
                <TextBlock Text="{Binding SelectedItem.Status, ElementName=LoaderLB}" Margin="5" Grid.Column="1" />

                <!-- Execute -->
                <Button x:Name="ExecuteButton"
                        Grid.Column="4"
                        Margin="5 0 0 0"
                        Click="ExecuteButton_Click"
                        Style="{StaticResource UserControlButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_Play" Style="{StaticResource FontAwesomeIconDefault}" Margin="5" />
                        <TextBlock Text="Execute" Style="{StaticResource LabelTextBlock}" Margin="5" />
                    </StackPanel>
                </Button>

                <!-- Pause -->
                <Button x:Name="PauseButton" 
                        Grid.Column="3"
                    Margin="5 0 0 0" 
                    Click="PauseButton_Click"
                    Style="{StaticResource UserControlButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pause" Style="{StaticResource LabelTextBlock}" Margin="5" />
                        <fa5:SvgAwesome Icon="Solid_Pause" Style="{StaticResource FontAwesomeIconDefault}" Margin="5" />
                    </StackPanel>
                </Button>

                <!-- Cancel -->
                <Button x:Name="CancelButton" 
                        Grid.Column="2"
                    Margin="5 0 0 0" 
                    Click="CancelButton_Click"
                    Style="{StaticResource UserControlButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cancel" Style="{StaticResource LabelTextBlock}" Margin="5" />
                        <fa5:SvgAwesome Icon="Solid_Stop" Style="{StaticResource FontAwesomeIconDefault}" Margin="5" />
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- Workflow Details -->
        <Border Grid.Column="1" 
                DataContext="{Binding SelectedItem, ElementName=LoaderLB}"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                <TextBlock Grid.Row="0" Margin="5" Text="{Binding DisplayName}" Style="{StaticResource LabelTextBlock}" />
                <TextBlock Grid.Row="1" Margin="5" Text="{Binding Description}" Style="{StaticResource LabelDetailParagraphTextBlock}" />

                <controls:ProgressBar Progress="{Binding WorkProgress}" 
                                  Grid.Row="2" 
                                  Margin="5"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource LibraryLoaderWorkflowItemProgressBarStyle}">
                </controls:ProgressBar>

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Queued" Grid.Row="3" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsWaiting}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="In Progress" Grid.Row="4" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsInProgress}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Successful" Grid.Row="5" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsSuccessful}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Error" Grid.Row="6" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsError}" Style="{StaticResource PropertyGridDetailUserControl}" />

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Status" Grid.Row="7" Margin="5 0 5 5" IsReadOnly="True" Value="Running" Style="{StaticResource PropertyGridDetailUserControl}" />

            </Grid>
        </Border>

    </Grid>
</UserControl>