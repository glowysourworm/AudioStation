<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportLoaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid">

    <Grid ColumnDefinitions="200, *">

        <!-- Loader Tasks (workflow) -->
        <ListBox x:Name="LoaderLB"
                 SelectedIndex="0"
                 ItemTemplate="{StaticResource LibraryImporterWorkflowItemTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}">
            
            <ListBoxItem DataContext="{Binding AcoustIDWorker}" 
                         Visibility="{Binding ImportOptions.IdentifyUsingAcoustID, Converter={StaticResource BoolVisibilityCollapseConverter}}" />
            
            <ListBoxItem DataContext="{Binding MusicBrainzBasicWorker}" 
                         Visibility="{Binding ImportOptions.IdentifyUsingMusicBrainz, Converter={StaticResource BoolVisibilityCollapseConverter}}" />
            
            <ListBoxItem DataContext="{Binding MusicBrainzAlbumArtWorker}" 
                         Visibility="{Binding ImportOptions.IncludeMusicBrainzArtwork, Converter={StaticResource BoolVisibilityCollapseConverter}}" />
        </ListBox>
        
        <!-- Input Files -->
        <ListBox x:Name="LoaderWorkItemsLB"
                 ItemsSource="{Binding SelectedItem.WorkItems, ElementName=LoaderLB}"
                 Grid.Column="1"
                 Margin="0"                 
                 ItemTemplate="{StaticResource LibraryWorkItemDataTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 HorizontalContentAlignment="Stretch">
        </ListBox>

    </Grid>
</UserControl>