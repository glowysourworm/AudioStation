<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportWorkflowSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/">
    
    <Grid ColumnDefinitions="260, *" RowDefinitions="Auto, Auto, Auto, Auto">

        <!-- Workflow Explanation -->
        <Border Grid.ColumnSpan="2" 
                Margin="5"         
                Style="{StaticResource InstructionsBorderStyle}">

            <TextBlock Style="{StaticResource InstructionsTextBlockStyle}" TextWrapping="Wrap" 
                       Text="Import Workflow:  The import process will take your audio files and directories; and turn them into a neatly organized file and database record library managed by Audio Station. This process may take some time as there are many available services with which to gather information about your audio library." />
        </Border>

        <Border Grid.ColumnSpan="2" 
                Margin="5"         
                Grid.Row="1"
                Style="{StaticResource InstructionsImportantBorderStyle}">

            <TextBlock Style="{StaticResource InstructionsTextBlockStyle}" TextWrapping="Wrap" 
                       Text="Your import process will be saved in the Audio Station database; and allow you to repeat the process at any time there are new library files to add; or in case you want to change your options for organizing all of your files. For this reason, you'll need to create an Audio Station Import Workflow so the application can help you keep track of your records." />
        </Border>

        <TextBlock Text="Workflow(s) (saved)" Style="{StaticResource LabelTextBlock}" Margin="5" Grid.Row="2" />

        <!-- Workflow(s) -->
        <ComboBox x:Name="WorkflowCB" 
                  ItemsSource="{Binding SavedWorkflows}" 
                  SelectedItem="{Binding Workflow}"
                  HorizontalContentAlignment="Stretch" 
                  Grid.Column="1" Grid.Row="2" Margin="5">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelTextBlock}" />
                        <TextBlock Text="(Last Modified)" Style="{StaticResource LabelTextBlock}" Grid.Column="1" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ModifiedDate}" Style="{StaticResource LabelTextBlock}" Grid.Column="2" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- New Workflow -->
        <Button x:Name="NewWorkflowButton" 
                Click="NewWorkflowButton_Click"
                HorizontalAlignment="Right"
                Margin="5"
                Style="{StaticResource UserControlButton}" Grid.Column="1" Grid.Row="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New Workflow" Style="{StaticResource LabelTextBlock}" />
                <fa5:SvgAwesome Icon="Solid_Plus" Style="{StaticResource FontAwesomeIconDefault}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
