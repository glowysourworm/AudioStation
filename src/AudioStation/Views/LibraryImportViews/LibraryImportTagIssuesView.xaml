<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportTagIssuesView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tagView="clr-namespace:AudioStation.Views.TagViews">
    
    <GroupBox Header="{Binding TagHeader, ElementName=BaseControl}">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Auto">
            <tagView:SmallTagView IsReadOnly="{Binding IsReadOnly, ElementName=BaseControl}"
                                  UseRequiredFields="{Binding UseRequiredFields, ElementName=BaseControl}"
                                  CanCopy="{Binding CanCopy, ElementName=BaseControl}"
                                  CopyTarget="{Binding CopyTarget, ElementName=BaseControl}" />
        </ScrollViewer>
    </GroupBox>
</UserControl>
