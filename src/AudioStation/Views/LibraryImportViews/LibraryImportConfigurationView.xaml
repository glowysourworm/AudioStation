<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:coreModel="clr-namespace:AudioStation.Core.Model;assembly=AudioStation.Core"
             xmlns:simpleUI="clr-namespace:SimpleWpf.UI.Controls;assembly=SimpleWpf.UI"
             xmlns:enumUI="clr-namespace:SimpleWpf.UI.Controls.EnumUI;assembly=SimpleWpf.UI"
             xmlns:configurationView="clr-namespace:AudioStation.Views.Configuration">

    <Grid RowDefinitions="Auto, Auto, Auto, *" ColumnDefinitions="260, *, Auto">

        <Border Grid.ColumnSpan="3" 
                Margin="5"
                Visibility="{Binding SelectedItem.ImportType, 
                                     ElementName=LibraryDirectoriesCB,
                                     Converter={StaticResource ParameterVisibilityCollapsedConverter}, 
                                     ConverterParameter={x:Static coreModel:LibraryImportType.InPlaceDirectory}}"
                Style="{StaticResource InstructionsBorderStyle}">

            <TextBlock Style="{StaticResource InstructionsTextBlockStyle}" TextWrapping="Wrap" 
                       Text="In Place Migration:  Import files into the library AS IS. This will prevent Audio Station from migrating, writing, or deleting files or directories." />
        </Border>

        <Border Grid.ColumnSpan="3" 
                Margin="5"
                Visibility="{Binding SelectedItem.ImportType, 
                                     ElementName=LibraryDirectoriesCB, 
                                     Converter={StaticResource ParameterVisibilityCollapsedConverter}, 
                                     ConverterParameter={x:Static coreModel:LibraryImportType.Migration}}"                
                Style="{StaticResource InstructionsBorderStyle}">

            <TextBlock Style="{StaticResource InstructionsTextBlockStyle}" TextWrapping="Wrap" 
                       Text="Migration (recommended):  This will take files from one location, convert them (optionally), apply tag information to them, and move them into a neatly organized library directory." />
        </Border>
                
        <TextBlock Text="Source Directory" Style="{StaticResource LabelTextBlock}" Margin="5" Grid.Row="1"
                   Visibility="{Binding SelectedItem.ImportType, 
                                        ElementName=LibraryDirectoriesCB, 
                   Converter={StaticResource ParameterVisibilityCollapsedConverter}, 
                   ConverterParameter={x:Static coreModel:LibraryImportType.Migration}}" />
        
        <TextBlock Text="Destination Directory" Style="{StaticResource LabelTextBlock}" Margin="5" Grid.Row="2" />

        <!-- Source Folder (Migration) -->
        <Grid Grid.Column="1" 
              Grid.Row="1" 
              ColumnDefinitions="*, Auto"
              Visibility="{Binding SelectedItem.ImportType, 
                                   ElementName=LibraryDirectoriesCB,
                                   Converter={StaticResource ParameterVisibilityCollapsedConverter}, 
                                   ConverterParameter={x:Static coreModel:LibraryImportType.Migration}}">
            
            <TextBox Text="{Binding Options.MigrationSourceDirectory}" Style="{StaticResource UserInputTextBoxReadonly}" Margin="5" Grid.Column="0" />
            <Button Grid.Column="1" Command="{Binding Options.SelectSourceFolderCommand}" Margin="5" Style="{StaticResource SmallControlButton}">
                <fa5:SvgAwesome Icon="Regular_FolderOpen" Height="16" Width="16" />
            </Button>
            
        </Grid>

        <!-- Destination Folder (Migration) -->
        <Grid Grid.Column="1" 
              Grid.Row="2" 
              ColumnDefinitions="*, Auto">

            <ComboBox x:Name="LibraryDirectoriesCB" 
                      DisplayMemberPath="DirectoryLabel"
                      SelectedItem="{Binding Options.ImportDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="5" />

        </Grid>

        <!-- Source Folder (In Place, or Library reference directories) -->
        <configurationView:ConfigurationLibraryDirectoriesView x:Name="LibraryDirectoriesView"
                                                               Grid.Column="0" 
                                                               Grid.ColumnSpan="2"
                                                               Grid.Row="3" 
                                                               Margin="5"
                                                               IsApplicationDirectoryView="False"
                                                               ConfigurationLocked="True" />

    </Grid>
</UserControl>
