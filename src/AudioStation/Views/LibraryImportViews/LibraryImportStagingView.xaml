<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportStagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:controls="clr-namespace:AudioStation.Controls"
             xmlns:coreModel="clr-namespace:AudioStation.Core.Model;assembly=AudioStation.Core"
             xmlns:simpleUI="clr-namespace:SimpleWpf.UI.Controls;assembly=SimpleWpf.UI"
             xmlns:simpleUITreeview="clr-namespace:SimpleWpf.UI.Controls.TreeViewUI;assembly=SimpleWpf.UI"
             xmlns:enumUI="clr-namespace:SimpleWpf.UI.Controls.EnumUI;assembly=SimpleWpf.UI"
             xmlns:libraryImporterViewModel="clr-namespace:AudioStation.ViewModels.ServiceComponent.LibraryImporterViewModels">
    
    <Grid RowDefinitions="Auto, Auto, *, Auto" ColumnDefinitions="*, Auto, *" DataContext="{Binding StagingWorkflow}">

        <!-- Input Files (In Place) -->
        <TextBox Margin="5" 
                 IsReadOnly="True"
                 Style="{StaticResource UserInputTextBoxReadonly}"
                 Text="{Binding ImportDirectory.FullPath}" 
                 Visibility="{Binding ImportOptions.ImportDirectory.ImportType, 
                                      Converter={StaticResource ParameterVisibilityCollapsedConverter}, 
                                      ConverterParameter={x:Static coreModel:LibraryImportType.InPlaceDirectory}}"
                 HorizontalAlignment="Stretch" />

        <!-- Input Files (Migration) -->
        <TextBox Margin="5" 
                 IsReadOnly="True"
                 Style="{StaticResource UserInputTextBoxReadonly}"
                 Text="{Binding ImportOptions.MigrationSourceDirectory}" 
                 Visibility="{Binding ImportOptions.ImportDirectory.ImportType, 
                                      Converter={StaticResource ParameterVisibilityCollapsedConverter}, 
                                      ConverterParameter={x:Static coreModel:LibraryImportType.Migration}}"
                 HorizontalAlignment="Stretch" />

        <xceed:WatermarkTextBox Margin="5" 
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding SourceFolderSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                Watermark="Search Import Files..." 
                                HorizontalAlignment="Stretch" />

        <!-- Staged Files (in memory) -->
        <xceed:WatermarkTextBox Margin="5" 
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="{Binding StagedSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" 
                                Watermark="Search Staged Files..." 
                                HorizontalAlignment="Stretch" />

        <!-- Staged File Filters -->
        <Grid ColumnDefinitions="Auto, *"
              Grid.Row="0" 
              Grid.Column="2" HorizontalAlignment="Stretch">

            <TextBlock Text="File Filter" Style="{StaticResource LabelTextBlock}" Margin="5" VerticalAlignment="Center" />

            <enumUI:SimpleEnumComboBox Grid.Column="1"
                                       Margin="5"
                                       Style="{StaticResource PropertyGridSimpleEnumComboBox}"
                                       EnumType="{x:Type libraryImporterViewModel:LibraryImporterStagedFileFilterType}"
                                       EnumValue="{Binding StagedFileFilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HorizontalAlignment="Stretch">
            </enumUI:SimpleEnumComboBox>

        </Grid>

        <!-- Input Files -->
        <simpleUITreeview:SimpleTreeView x:Name="ImportTV"
                                         Margin="5"
                                         Grid.Row="2"
                                         Style="{StaticResource FileTreeViewStyle}"
                                         ItemsSource="{Binding ImportDirectory, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
        </simpleUITreeview:SimpleTreeView>
        
        <!-- Stage / Unstage -->
        <StackPanel Orientation="Vertical" 
                    VerticalAlignment="Center"
                    Grid.Row="2"
                    Grid.Column="1">

            <Button Style="{StaticResource SmallControlButton}"
                    Command="{Binding StageCommand}"
                    ToolTip="Stage for Import"
                    Height="32"
                    Width="32">
                <fa5:SvgAwesome Icon="Solid_ArrowRight" Style="{StaticResource FontAwesomeIconControlPanelButton}" />
            </Button>

            <Button Style="{StaticResource SmallControlButton}"
                    Command="{Binding UnstageCommand}"
                    ToolTip="Unstage from Import"
                    Height="32"
                    Width="32"
                    Margin="0 5 0 0">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Style="{StaticResource FontAwesomeIconControlPanelButton}" />
            </Button>

        </StackPanel>

        <!-- Staged Files -->
        <simpleUITreeview:SimpleTreeView x:Name="StagedTV"
                                         Grid.Column="2"
                                         Grid.Row="2"
                                         Margin="5"
                                         Style="{StaticResource LibraryImporterStagingFileTreeViewStyle}"
                                         ItemsSource="{Binding StagedFiles, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
        </simpleUITreeview:SimpleTreeView>

        <Border Grid.Column="0" 
                Grid.Row="3" 
                Margin="5" 
                Style="{StaticResource FooterBorderStyle}">
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                <TextBlock Text="Total File(s)" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="0" />
                <TextBlock Text="Total Director(y|ies)" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="0" Grid.Row="1" />
                <TextBlock Text="Selected File(s)" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="0" Grid.Row="2" />

                <TextBlock Text="{Binding ImportDirectory.TotalFileCount}" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ImportDirectory.TotalDirectoryCount}" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ImportDirectory.SelectedFileCount}" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Column="2" 
                Grid.Row="3" 
                Margin="5" 
                Style="{StaticResource FooterBorderStyle}">
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                <TextBlock Text="Total File(s)" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="0" />
                <TextBlock Text="Selected File(s)" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="0" Grid.Row="1" />
                <TextBlock Text="Library Conflict(s)" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="0" Grid.Row="2" />

                <TextBlock Text="{Binding StagedFiles.TotalFileCount}" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding StagedFiles.SelectedFileCount}" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding StagedFiles.LibraryConflictFiles.Count}" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
