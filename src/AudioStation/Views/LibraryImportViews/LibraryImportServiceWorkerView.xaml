<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportServiceWorkerView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:view="clr-namespace:AudioStation.Views"
             xmlns:region="clr-namespace:SimpleWpf.IocFramework.RegionManagement;assembly=SimpleWpf.IocFramework"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:coreComponent="clr-namespace:AudioStation.Core.Component;assembly=AudioStation.Core"
             xmlns:controls="clr-namespace:AudioStation.Controls">

    <!-- DataContext:  The LibraryImporterServiceWorkflowViewModel must be the data context; and there may be multiple instances -->
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, *">

        <!-- Loader Tasks (workflow) -->
        <ListBox x:Name="LoaderLB"
                 IsEnabled="False"
                 Grid.Column="0"
                 Grid.RowSpan="3"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch"                 
                 SelectedItem="{Binding SelectedWorker}"
                 ItemsSource="{Binding ServiceWorkers}"
                 ItemTemplate="{StaticResource LibraryImporterWorkflowItemTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}"
                 Visibility="{Binding ExecuteAsBulk, Converter={StaticResource BoolVisibilityCollapseConverter}}">
        </ListBox>

        <region:IocRegion Grid.Column="1"
                          Grid.RowSpan="3"
                          region:IocRegionManager.DefaultViewType="{x:Type view:LibraryLoaderWorkerView}"
                          DataContext="{Binding SelectedWorker, UpdateSourceTrigger=PropertyChanged}" />

    </Grid>
</UserControl>