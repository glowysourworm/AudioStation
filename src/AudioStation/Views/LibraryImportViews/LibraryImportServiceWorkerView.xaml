<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportServiceWorkerView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:coreComponent="clr-namespace:AudioStation.Core.Component;assembly=AudioStation.Core"
             xmlns:controls="clr-namespace:AudioStation.Controls">

    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, *">

        <!-- Loader Tasks (workflow) -->
        <ListBox x:Name="LoaderLB"
                 IsEnabled="False"
                 Grid.Column="0"
                 Grid.RowSpan="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch"                 
                 SelectedItem="{Binding ServiceWorkflow.SelectedWorker}"
                 ItemsSource="{Binding ServiceWorkflow.ServiceWorkers}"
                 ItemTemplate="{StaticResource LibraryImporterWorkflowItemTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}">
        </ListBox>
        
        <!-- Input Files -->
        <ListBox x:Name="LoaderWorkItemsLB"
                 ItemsSource="{Binding SelectedItem.WorkItems, ElementName=LoaderLB}"
                 MouseDoubleClick="LoaderWorkItemsLB_MouseDoubleClick"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Grid.Row="2"
                 Margin="0"                                  
                 ItemTemplate="{StaticResource LibraryWorkItemDataTemplate}"
                 ItemContainerStyle="{StaticResource SimpleUIItemContainerStyle}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.CacheLength="3"
                 VirtualizingPanel.CacheLengthUnit="Item"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch">
        </ListBox>

        <!-- PROCESSING:  Execute, Pause, Canel -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{StaticResource HeaderBackground}">

            <Grid ColumnDefinitions="Auto, Auto, *, Auto"
                  Margin="2"
                  IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}">

                <Button Grid.Column="0"
                        Style="{StaticResource UserControlButton}"
                        VerticalAlignment="Center"
                        Command="{Binding ServiceWorkflow.MoveToPreviousStepCommand}"
                        Margin="3">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_ArrowLeft" Style="{StaticResource FontAwesomeIconDefault}" />
                        <TextBlock Text="Previous" Style="{StaticResource LabelTextBlock}" FontSize="12" Margin="3" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource UserControlButton}"
                        Command="{Binding ServiceWorkflow.MoveToNextStepCommand }"
                        Margin="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" Style="{StaticResource LabelTextBlock}" FontSize="12" Margin="3" />
                        <fa5:SvgAwesome Icon="Solid_ArrowRight" Style="{StaticResource FontAwesomeIconDefault}" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="2" Margin="3" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Style="{StaticResource LabelDetailDarkTextBlock}"
                           Text="You can execute next service step(s) when the work items have completed processing. If you need to go back and review your work just stop the service workers using the buttons to the right." />

                <StackPanel Orientation="Horizontal" Grid.Column="3" HorizontalAlignment="Left">

                    <!-- Cancel -->
                    <ToggleButton x:Name="CancelButton" 
                                  Click="CancelButton_Click"
                                  Margin="0 3"
                                  Style="{StaticResource LargeInputControlToggleButton}">
                        <fa5:SvgAwesome Icon="Solid_Stop" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                    </ToggleButton>                    
                    
                    <!-- Pause -->
                    <ToggleButton x:Name="PauseButton" 
                                  Click="PauseButton_Click"
                                  Margin="0 3"
                                  Style="{StaticResource LargeInputControlToggleButton}">
                        <fa5:SvgAwesome Icon="Solid_Pause" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                    </ToggleButton>

                    <!-- Execute -->
                    <ToggleButton x:Name="ExecuteButton"
                                  Margin="0 3"
                                  Click="ExecuteButton_Click"                              
                                  Style="{StaticResource LargeInputControlToggleButton}">
                        <fa5:SvgAwesome Icon="Solid_Play" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                    </ToggleButton>

                    <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource UserControlButton}"
                        Command="{Binding ServiceWorkflow.RerunSelectedWorkItemsCommand}"
                        Margin="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rerun" Style="{StaticResource LabelTextBlock}" FontSize="12" Margin="5" />
                            <fa5:SvgAwesome Icon="Solid_Recycle" Style="{StaticResource FontAwesomeIconDefault}" Height="12" Width="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource UserControlButton}"
                            Command="{Binding ServiceWorkflow.SkipSelectedWorkItemsCommand}"
                            Margin="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Skip" Style="{StaticResource LabelTextBlock}" FontSize="12" Margin="5" />
                            <fa5:SvgAwesome Icon="Solid_AngleDoubleRight" Style="{StaticResource FontAwesomeIconDefault}" Height="12" Width="12" />
                        </StackPanel>
                    </Button>


                    <Grid ColumnDefinitions="Auto, Auto, Auto, Auto" VerticalAlignment="Center" Margin="3">
                        <TextBlock Text="Selected " Style="{StaticResource LabelDetailDarkTextBlock}" />
                        <TextBlock Text="(" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="1" />
                        <TextBlock Text="{Binding SelectedItems.Count, ElementName=LoaderWorkItemsLB}"  Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="2" />
                        <TextBlock Text=")" Style="{StaticResource LabelDetailDarkTextBlock}" Grid.Column="3" />
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Workflow Details -->
        <Border Grid.Column="1" 
                Grid.RowSpan="1"
                DataContext="{Binding ServiceWorkflow.SelectedWorker}"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto">

                <TextBlock Grid.Row="0" Margin="5" Text="{Binding Name}" Style="{StaticResource LabelTextBlock}" />
                <TextBlock Grid.Row="1" Margin="5" Text="{Binding Description}" Style="{StaticResource LabelDetailParagraphTextBlock}" />

                <controls:ProgressBar Progress="{Binding TotalProgress}" 
                                  Grid.Row="2" 
                                  Margin="5"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource LibraryLoaderWorkflowItemProgressBarStyle}">
                </controls:ProgressBar>

                <!-- Latest Log Message-->
                <Grid Grid.Row="3" ColumnDefinitions="Auto, *">
                    <TextBlock Text="Message:" Margin="5" Style="{StaticResource LabelDetailDarkTextBlock}" />
                    
                    <TextBlock Margin="5" Grid.Column="1"                               
                               Text="{Binding SelectedItem.LastMessage, ElementName=LoaderWorkItemsLB}" 
                               Visibility="{Binding SelectedItem, ElementName=LoaderWorkItemsLB, Converter={StaticResource NonNullVisibilityConverter}}"
                               Foreground="{StaticResource LogForeground}" 
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource LabelDetailDarkTextBlock}" />

                    <TextBlock Margin="5" Grid.Column="1"                               
                               Text="{Binding LastWorkItemMessage}" 
                               Visibility="{Binding SelectedItem, ElementName=LoaderWorkItemsLB, Converter={StaticResource NullVisibilityConverter}}"
                               Foreground="{StaticResource LogForeground}" 
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource LabelDetailDarkTextBlock}" />
                </Grid>

            </Grid>
        </Border>

        <!-- Workflow Details -->
        <Border Grid.Column="2" 
                Grid.RowSpan="1"
                DataContext="{Binding ServiceWorkflow.SelectedWorker}"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Pending" Margin="5 0" IsReadOnly="True" Value="{Binding WorkPendingCount}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Processing" Grid.Row="1" Margin="5 0" IsReadOnly="True" Value="{Binding WorkInProgressCount}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Successful" Grid.Row="2" Margin="5 0" IsReadOnly="True" Value="{Binding WorkSuccessCount}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Error" Grid.Row="3" Margin="5 0" IsReadOnly="True" Value="{Binding WorkErrorCount}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Canceled" Grid.Row="4" Margin="5 0" IsReadOnly="True" Value="{Binding WorkCanceledCount}" Style="{StaticResource PropertyGridDetailUserControl}" />

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Status" Grid.Row="5" Margin="5 0 5 5" IsReadOnly="True" Value="{Binding Status}" Style="{StaticResource PropertyGridDetailUserControl}" />

            </Grid>
        </Border>

    </Grid>
</UserControl>