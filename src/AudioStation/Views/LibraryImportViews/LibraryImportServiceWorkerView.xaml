<UserControl x:Class="AudioStation.Views.LibraryImportViews.LibraryImportServiceWorkerView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:propertyGrid="clr-namespace:AudioStation.Controls.PropertyGrid"
             xmlns:coreComponent="clr-namespace:AudioStation.Core.Component;assembly=AudioStation.Core"
             xmlns:controls="clr-namespace:AudioStation.Controls">

    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, *">

        <!-- Loader Tasks (workflow) -->
        <ListBox x:Name="LoaderLB"
                 SelectedIndex="0"
                 Grid.Column="0"
                 Grid.RowSpan="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch"
                 ItemTemplate="{StaticResource LibraryImporterWorkflowItemTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}">
        </ListBox>
        
        <!-- Input Files -->
        <ListBox x:Name="LoaderWorkItemsLB"
                 ItemsSource="{Binding SelectedItem.WorkItems, ElementName=LoaderLB}"
                 MouseDoubleClick="LoaderWorkItemsLB_MouseDoubleClick"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Grid.Row="2"
                 Margin="0"                 
                 ItemTemplate="{StaticResource LibraryWorkItemDataTemplate}"
                 ItemContainerStyle="{StaticResource SimpleItemContainerStyle}"
                 SelectionMode="Extended"
                 AlternationCount="2"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.CacheLength="3"
                 VirtualizingPanel.CacheLengthUnit="Item"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch">
        </ListBox>

        <!-- PROCESSING:  Execute, Pause, Canel -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{StaticResource HeaderBackground}">

            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto"
                  Margin="2"
                  IsEnabled="{Binding Loading, Converter={StaticResource BoolInverseConverter}}">

                <TextBlock Text="Import Workflow:" Margin="5" />
                <TextBlock Text="{Binding Workflow.Name}" Margin="5" Grid.Column="1" />

                <!-- Execute -->
                <ToggleButton x:Name="ExecuteButton"
                        Grid.Column="4"
                        Click="ExecuteButton_Click"
                        Style="{StaticResource LargeInputControlToggleButton}">
                        <fa5:SvgAwesome Icon="Solid_Play" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                </ToggleButton>

                <!-- Pause -->
                <ToggleButton x:Name="PauseButton" 
                        Grid.Column="3"
                        Click="PauseButton_Click"
                        Style="{StaticResource LargeInputControlToggleButton}">
                    <fa5:SvgAwesome Icon="Solid_Pause" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                </ToggleButton>

                <!-- Cancel -->
                <ToggleButton x:Name="CancelButton" 
                        Grid.Column="2"
                        Click="CancelButton_Click"
                        Style="{StaticResource LargeInputControlToggleButton}">
                        <fa5:SvgAwesome Icon="Solid_Stop" Style="{StaticResource FontAwesomeIconDefault}" Margin="3" Height="12" Width="12" />
                </ToggleButton>

            </Grid>
        </Border>

        <!-- Workflow Details -->
        <Border Grid.Column="1" 
                Grid.RowSpan="1"
                DataContext="{Binding SelectedItem, ElementName=LoaderLB}"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto">

                <TextBlock Grid.Row="0" Margin="5" Text="{Binding Name}" Style="{StaticResource LabelTextBlock}" />
                <TextBlock Grid.Row="1" Margin="5" Text="{Binding Description}" Style="{StaticResource LabelDetailParagraphTextBlock}" />

                <controls:ProgressBar Progress="{Binding WorkProgress}" 
                                  Grid.Row="2" 
                                  Margin="5"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource LibraryLoaderWorkflowItemProgressBarStyle}">
                </controls:ProgressBar>

                <!-- Latest Log Message-->
                <Grid Grid.Row="3" ColumnDefinitions="Auto, *">
                    <TextBlock Text="Message:" Margin="5" Style="{StaticResource LabelDetailDarkTextBlock}" />
                    
                    <TextBlock Margin="5" Grid.Column="1"                               
                               Text="{Binding SelectedItem.LastMessage, ElementName=LoaderWorkItemsLB}" 
                               Visibility="{Binding SelectedItem, ElementName=LoaderWorkItemsLB, Converter={StaticResource NonNullVisibilityConverter}}"
                               Foreground="{StaticResource LogForeground}" 
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource LabelDetailDarkTextBlock}" />

                    <TextBlock Margin="5" Grid.Column="1"                               
                               Text="{Binding LastWorkItemMessage}" 
                               Visibility="{Binding SelectedItem, ElementName=LoaderWorkItemsLB, Converter={StaticResource NullVisibilityConverter}}"
                               Foreground="{StaticResource LogForeground}" 
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource LabelDetailDarkTextBlock}" />
                </Grid>

            </Grid>
        </Border>

        <!-- Workflow Details -->
        <Border Grid.Column="2" 
                Grid.RowSpan="1"
                DataContext="{Binding SelectedItem, ElementName=LoaderLB}"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Queued" Grid.Row="3" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsWaiting}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="In Progress" Grid.Row="4" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsInProgress}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Successful" Grid.Row="5" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsSuccessful}" Style="{StaticResource PropertyGridDetailUserControl}" />
                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Error" Grid.Row="6" Margin="5 0" IsReadOnly="True" Value="{Binding WorkItemsError}" Style="{StaticResource PropertyGridDetailUserControl}" />

                <propertyGrid:PropertyLabelControl LabelColumnWidth="160" LabelText="Status" Grid.Row="7" Margin="5 0 5 5" IsReadOnly="True" Value="{Binding Status}" Style="{StaticResource PropertyGridDetailUserControl}" />

            </Grid>
        </Border>

    </Grid>
</UserControl>