<local:PropertyGridControl x:Class="AudioStation.Controls.PropertyGrid.PropertyButtonLabelControl"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:local="clr-namespace:AudioStation.Controls.PropertyGrid">
    <Grid RowDefinitions="Auto, Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ColumnDefinition Width="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
				   Style="{StaticResource PropertyGridLabel}" Grid.Column="0"
                   Margin="3"
                   Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>        
        
        <Button Content="{Binding ButtonContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="3"
                Grid.Column="1"
                Style="{StaticResource PropertyGridButtonLabel}"
                IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInverseConverter}}"
                Command="{Binding ButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!-- Description (Right) -->
        <TextBlock Grid.Column="2"
                   Margin="3"
                   Style="{StaticResource PropertyGridLabelDetail}"
                   TextWrapping="Wrap"
                   TextTrimming="None"                   
			       Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock.Visibility>
                <MultiBinding Converter="{StaticResource BoolANDVisibilityMultiConverter}">
                    <Binding Path="Description" RelativeSource="{RelativeSource AncestorType=UserControl}" Converter="{StaticResource NonNullBoolConverter}" />
                    <Binding Path="DescriptionPlacement" 
                             RelativeSource="{RelativeSource AncestorType=UserControl}" 
                             Converter="{StaticResource ParameterEqualityBoolConverter}"
                             ConverterParameter="{x:Static local:PropertyGridDescriptionPlacement.Right}" />
                </MultiBinding>
            </TextBlock.Visibility>
        </TextBlock>

        <!-- Description (Below) -->
        <TextBlock Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"
                   Margin="3"
                   Style="{StaticResource PropertyGridLabelDetail}"
                   TextWrapping="Wrap"
                   TextTrimming="None"                   
			       Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock.Visibility>
                <MultiBinding Converter="{StaticResource BoolANDVisibilityMultiConverter}">
                    <Binding Path="Description" RelativeSource="{RelativeSource AncestorType=UserControl}" Converter="{StaticResource NonNullBoolConverter}" />
                    <Binding Path="DescriptionPlacement" 
                             RelativeSource="{RelativeSource AncestorType=UserControl}" 
                             Converter="{StaticResource ParameterEqualityBoolConverter}"
                             ConverterParameter="{x:Static local:PropertyGridDescriptionPlacement.Below}" />
                </MultiBinding>
            </TextBlock.Visibility>
        </TextBlock>
    </Grid>
</local:PropertyGridControl>
