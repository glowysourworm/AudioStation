<local:PropertyGridControl x:Class="AudioStation.Controls.PropertyGrid.PropertyBooleanControl"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
                           xmlns:local="clr-namespace:AudioStation.Controls.PropertyGrid">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
				   Style="{StaticResource PropertyGridLabel}" />

        <CheckBox Grid.Column="1" 
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="3"
                  BorderBrush="{Binding IsValid, Converter={StaticResource ValidationBrushConverter}, ConverterParameter={StaticResource PropertyGridControlDefaultBorder}, RelativeSource={RelativeSource AncestorType=UserControl}}"
				  IsChecked="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" 
				  IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInverseConverter}}" />

        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NonNullVisibilityConverter}}"
                   Style="{StaticResource PropertyGridLabel}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Margin="3"
                   Grid.Column="2" />
    </Grid>
</local:PropertyGridControl>
