<local:PropertyGridControl x:Class="AudioStation.Controls.PropertyGrid.PropertyPasswordControl"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
                             xmlns:local="clr-namespace:AudioStation.Controls.PropertyGrid"
                             xmlns:simpleUIValidation="clr-namespace:SimpleWpf.UI.ValidationRules;assembly=SimpleWpf.UI">
    <Grid RowDefinitions="Auto, Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
				   Style="{StaticResource PropertyGridLabel}" />

        <xceed:WatermarkPasswordBox x:Name="PasswordTB" 
                                    TextChanged="PasswordTB_TextChanged"
                                    Grid.Column="1" 
                                    Style="{StaticResource PropertyGridPasswordBox}"
                                    BorderBrush="{Binding IsValid, Converter={StaticResource ValidationBoolForegroundParameterConverter},ConverterParameter={StaticResource PropertyGridControlDefaultBorder},  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="3"
                                    TextWrapping="NoWrap"
                                    IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}">
        </xceed:WatermarkPasswordBox>


        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NonNullVisibilityConverter}}"
                   Style="{StaticResource PropertyGridLabel}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Margin="3"
                   Grid.Row="1"
                   Grid.Column="1" />
    </Grid>
    
</local:PropertyGridControl>
