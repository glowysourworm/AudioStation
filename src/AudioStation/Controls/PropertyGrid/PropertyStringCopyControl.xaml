<local:PropertyGridControl x:Class="AudioStation.Controls.PropertyGrid.PropertyStringCopyControl"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:local="clr-namespace:AudioStation.Controls.PropertyGrid"
                             xmlns:simpleUIValidation="clr-namespace:SimpleWpf.UI.ValidationRules;assembly=SimpleWpf.UI">
    <Grid RowDefinitions="Auto, Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button x:Name="CopyButton"                
                Click="CopyButton_Click"
                Visibility="{Binding CanCopy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibilityCollapseConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="TheEllipse" Stroke="LightGray" Fill="AliceBlue" Width="12" Height="12" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TheEllipse" Property="Fill" Value="DodgerBlue" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TheEllipse" Property="Fill" Value="LightSkyBlue" />
                        </Trigger>                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>                

        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
				   Style="{StaticResource PropertyGridLabel}"
                   Grid.Column="1" />

        <TextBox Grid.Column="2" 
                 Style="{StaticResource PropertyGridTextBox}"
                 BorderBrush="{Binding IsValid, Converter={StaticResource ValidationBoolForegroundParameterConverter},ConverterParameter={StaticResource PropertyGridControlDefaultBorder},  RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 Margin="3"
                 TextWrapping="NoWrap"
                 IsReadOnly="{Binding IsReadOnly, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}">
        </TextBox>


        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NonNullVisibilityConverter}}"
                   Style="{StaticResource PropertyGridLabel}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Margin="3"
                   Grid.Row="1"
                   Grid.Column="2" />
    </Grid>
    
</local:PropertyGridControl>
