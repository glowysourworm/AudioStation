<local:PropertyGridControl x:Class="AudioStation.Controls.PropertyGrid.PropertyIntCopyControl"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
                             xmlns:local="clr-namespace:AudioStation.Controls.PropertyGrid">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button x:Name="CopyButton"                
                Click="CopyButton_Click"
                Visibility="{Binding CanCopy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibilityCollapseConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="TheEllipse" Stroke="LightGray" Fill="AliceBlue" Width="12" Height="12" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TheEllipse" Property="Fill" Value="DodgerBlue" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TheEllipse" Property="Fill" Value="LightSkyBlue" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   Margin="3"
				   Style="{StaticResource PropertyGridLabel}" Grid.Column="1" />

        <xceed:IntegerUpDown Grid.Column="2" 
                             Margin="3"
                             BorderBrush="{Binding IsValid, NotifyOnTargetUpdated=True, ConverterParameter={StaticResource PropertyGridControlDefaultBorder}, Converter={StaticResource ValidationBoolForegroundParameterConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Minimum="{Binding ValueMin, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Maximum="{Binding ValueMax, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"                             
				             Value="{Binding Value, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}" 
				             IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</local:PropertyGridControl>
