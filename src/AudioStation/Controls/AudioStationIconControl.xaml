<UserControl x:Class="AudioStation.Controls.AudioStationIconControl"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="http://schemas.fontawesome.com/icons/">
    
        <Grid>

            <Image Stretch="Uniform" 
                   StretchDirection="Both" 
                   Source="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <Grid x:Name="ActivityBadgeGrid"
                  Margin="0 0 -5 -5"
                  Visibility="{Binding ActivityBadgeCount, 
                    Converter={StaticResource ParameterVisibilityGreaterThanConverter},
                    ConverterParameter=0}">

                <Ellipse Width="10" Height="10" Fill="DodgerBlue" />

                <TextBlock Text="{Binding ActivityBadgeCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Visibility="{Binding ActivityBadgeCount, 
                              Converter={StaticResource ParameterVisibilityLessThanConverter},
                              ConverterParameter=10}"
                           FontSize="10"
                           Foreground="White" />

                <TextBlock Text="+"
                           Visibility="{Binding ActivityBadgeCount, 
                              Converter={StaticResource ParameterVisibilityGreaterThanConverter},
                              ConverterParameter=9}"
                           FontSize="10"
                           Foreground="White" />
            </Grid>

        </Grid>
</UserControl>
