<UserControl x:Class="AudioStation.Controls.MultiSelectTreeView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioStation.Controls"
             xmlns:viewModel="clr-namespace:AudioStation.ViewModels.Controls"
             xmlns:fa5="http://schemas.fontawesome.com/icons/">
    
    <UserControl.Resources>

        <!-- Collection (Non-Selectable) -->
        <Style TargetType="ListBoxItem" x:Key="MultiSelectTreeViewListBoxItemContainerStyle">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Margin}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leaf (Selectable) -->
        <Style TargetType="ListBoxItem" x:Key="MultiSelectTreeViewListBoxItemSelectionContainerStyle">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Margin}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Style -->
        <Style TargetType="ListBox" x:Key="MultiSelectTreeViewListBoxStyle">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplateSelector" Value="{StaticResource MultiSelectTreeViewItemTemplateSelector}" />
            <Setter Property="ItemContainerStyleSelector" Value="{StaticResource MultiSelectTreeViewItemContainerStyleSelector}" />
        </Style>

        <!-- Leaf Template (Indent) -->
        <DataTemplate x:Key="MultiSelectTreeViewLeafItemTemplate">

            <Grid>

                <!-- Header -->
                <ContentPresenter Margin="29 3 3 3"
                                  Content="{Binding ItemDisplay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  TextBlock.TextAlignment="Left"
                                  TextBlock.FontSize="14">
                </ContentPresenter>
                
            </Grid>

        </DataTemplate>

        <!-- Leaf Template (No Indent) -->
        <DataTemplate x:Key="MultiSelectTreeViewLeafNoIndentItemTemplate">

            <Grid>

                <!-- Header -->
                <ContentPresenter Visibility="{Binding CanHaveChildren, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                                  Margin="3 3 3 3"
                                  Content="{Binding ItemDisplay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  TextBlock.TextAlignment="Left"
                                  TextBlock.FontSize="14">
                </ContentPresenter>

            </Grid>

        </DataTemplate>

        <!-- Collection Template -->
        <DataTemplate x:Key="MultiSelectTreeViewCollectionItemTemplate">

            <Grid RowDefinitions="Auto, *" ColumnDefinitions="26, *">

                <!-- Header -->
                <Border x:Name="HeaderBorder"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch">

                    <Grid ColumnDefinitions="26, *">
                        
                        <!-- Expander -->
                        <ToggleButton x:Name="InputFileExpanderButton"
                                      Margin="3"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding CanHaveChildren, Converter={StaticResource BoolVisibilityCollapseConverter}}">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">

                                        <fa5:ImageAwesome Icon="Regular_Folder"                                                     
                                                    Style="{StaticResource FontAwesomeIconManagerViewPager}"
                                                    Margin="3"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolInverseVisibilityCollapseConverter}}" />

                                        <fa5:ImageAwesome Icon="Regular_FolderOpen"                                                     
                                                    Style="{StaticResource FontAwesomeIconManagerViewPager}"
                                                    Margin="3"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibilityCollapseConverter}}" />
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>


                        <ContentPresenter 
                            Grid.Column="1"
                            Margin="3"
                            Content="{Binding ItemDisplay}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            TextBlock.TextAlignment="Left"
                            TextBlock.FontSize="14">
                        </ContentPresenter>
                    </Grid>
                </Border>

                <!-- Items -->
                <ListBox x:Name="LeafLB"
                         Grid.Row="1" 
                         Grid.Column="1"
                         ItemsSource="{Binding Children}"
                         ItemTemplateSelector="{StaticResource MultiSelectTreeViewItemTemplateSelector}"
                         Style="{StaticResource MultiSelectTreeViewListBoxStyle}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.CanContentScroll="False"                         
                         VirtualizingPanel.IsVirtualizing="True"
                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibilityCollapseConverter}}">
                </ListBox>

            </Grid>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True" SourceName="HeaderBorder">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" TargetName="HeaderBorder" Value="{Binding SelectionBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTrigger>
            </DataTemplate.Triggers>

        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer x:Name="TheScrollViewer" CanContentScroll="False"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  BorderBrush="{Binding BorderBrush, ElementName=BaseControl}"
                  BorderThickness="{Binding BorderThickness, ElementName=BaseControl}">
        <Grid>

            <ListBox x:Name="TheTreeView" 
                     Margin="{Binding Margin, ElementName=BaseControl}"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.CanContentScroll="False"
                     SelectionMode="Extended"
                     Style="{StaticResource MultiSelectTreeViewListBoxStyle}">
            </ListBox>

        </Grid>
    </ScrollViewer>
</UserControl>
