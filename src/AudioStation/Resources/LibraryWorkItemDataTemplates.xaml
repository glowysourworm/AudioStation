<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModel="clr-namespace:AudioStation.ViewModels.ComponentViewModels.LibraryLoaderViewModels"
                    xmlns:viewModelInterface="clr-namespace:AudioStation.ViewModels.ComponentViewModels.LibraryLoaderViewModels.Interface"
                    xmlns:controls="clr-namespace:AudioStation.Controls"
                    xmlns:coreComponent="clr-namespace:AudioStation.Core.Component;assembly=AudioStation.Core"
                    xmlns:coreModel="clr-namespace:AudioStation.Core.Model;assembly=AudioStation.Core"
                    xmlns:libraryComponent="clr-namespace:AudioStation.Core.Component.LibraryLoaderComponent;assembly=AudioStation.Core">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/ThemeColorsAndBrushes.xaml" />
        <ResourceDictionary Source="/Resources/TextBlockStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ProgressBarStyle" TargetType="{x:Type controls:ProgressBar}">
        <Setter Property="Foreground" Value="#AF000000" />
        <Setter Property="Background" Value="LightGray" />
        <Setter Property="ProgressBrush" Value="LawnGreen" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>

    <Style x:Key="LibraryLoaderWorkItemProgressBarStyle" TargetType="{x:Type controls:ProgressBar}">
        <Setter Property="Foreground" Value="#AF000000" />
        <Setter Property="Background" Value="LightGray" />
        <Setter Property="ProgressBrush" Value="LawnGreen" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                <Setter Property="ProgressBrush" Value="Red" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PreviousErrorType}" Value="{x:Static libraryComponent:LibraryWorkerResultLevel.Failure}">
                <Setter Property="ProgressBrush" Value="Yellow" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PreviousErrorType}" Value="{x:Static libraryComponent:LibraryWorkerResultLevel.DataError}">
                <Setter Property="ProgressBrush" Value="Red" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PreviousErrorType}" Value="{x:Static libraryComponent:LibraryWorkerResultLevel.ServiceNoResult}">
                <Setter Property="ProgressBrush" Value="Yellow" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PreviousErrorType}" Value="{x:Static libraryComponent:LibraryWorkerResultLevel.ServiceFailure}">
                <Setter Property="ProgressBrush" Value="Red" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryLoaderWorkflowItemProgressBarStyle" TargetType="{x:Type controls:ProgressBar}">
        <Setter Property="Foreground" Value="#AF000000" />
        <Setter Property="Background" Value="LightGray" />
        <Setter Property="ProgressBrush" Value="DodgerBlue" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>

    <Style x:Key="LibraryWorkItemContainerStyleNormal" TargetType="ListBoxItem">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource LabelForeground}" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverSelectBackgroundHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverSelectBackgroundSelect}" />
            </Trigger>            
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryWorkItemContainerStylePending" TargetType="ListBoxItem" BasedOn="{StaticResource LibraryWorkItemContainerStyleNormal}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource LabelForeground}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style x:Key="LibraryWorkItemContainerStyleSuccess" TargetType="ListBoxItem" BasedOn="{StaticResource LibraryWorkItemContainerStyleNormal}">
        <Setter Property="Background" Value="{StaticResource LabelBackgroundSuccess}" />
        <Setter Property="Foreground" Value="{StaticResource LabelForeground}" />
    </Style>

    <Style x:Key="LibraryWorkItemContainerStyleError" TargetType="ListBoxItem" BasedOn="{StaticResource LibraryWorkItemContainerStyleNormal}">
        <Setter Property="Background" Value="{StaticResource LabelBackgroundError}" />
        <Setter Property="Foreground" Value="{StaticResource LabelForeground}" />
    </Style>

    <DataTemplate x:Key="LibraryWorkItemDataTemplate" DataType="{x:Type viewModel:LibraryWorkItemViewModel}">
        <Border Padding="3" x:Name="Bd"
                ToolTip="{Binding LastMessage}">
            
            <Grid ColumnDefinitions="90, 120, *">

                <TextBlock Grid.Column="0" Margin="5 0 0 0" Text="{Binding State, StringFormat='({0})'}" />
                
                <controls:ProgressBar Progress="{Binding Progress}" 
                                      Grid.Column="1" Margin="5 0"
                                      Style="{StaticResource LibraryLoaderWorkItemProgressBarStyle}" 
                                      Visibility="{Binding State, 
                                      Converter={StaticResource ParameterVisibilityCollapsedInverseConverter},
                                      ConverterParameter={x:Static libraryComponent:LibraryWorkItemState.Error}}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right">
                </controls:ProgressBar>

                <TextBlock Grid.Column="1" Margin="5 0 0 0" Text="Error (see log)" 
                           Visibility="{Binding State, 
                           Converter={StaticResource ParameterVisibilityCollapsedConverter},
                           ConverterParameter={x:Static libraryComponent:LibraryWorkItemState.Error}}" />

                <TextBlock Grid.Column="2" Margin="5 0 0 0" Text="{Binding Load.Payload}" Style="{StaticResource LabelTextBlock}" />

            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State, 
                         Converter={StaticResource ParameterEqualityBoolConverter}, 
                         ConverterParameter={x:Static libraryComponent:LibraryWorkItemState.Error}}" Value="True">
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource WorkItemBackgroundError}" />
            </DataTrigger>
        </DataTemplate.Triggers>
        
    </DataTemplate>

    <DataTemplate x:Key="LibraryImporterWorkflowItemTemplate" DataType="{x:Type viewModelInterface:ILibraryLoaderWorkerViewModel}">

        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" Width="260"
              ToolTip="{Binding Description}">

            <TextBlock Grid.Row="0" 
                       Margin="5" 
                       Text="{Binding Name}" 
                       Style="{StaticResource LabelTextBlock}"  />
            
            <TextBlock Grid.Row="0" 
                       Grid.Column="1" 
                       Margin="5" 
                       Text="Running" 
                       Visibility="{Binding Working, Converter={StaticResource BoolVisibilityCollapseConverter}}"
                       Style="{StaticResource LabelDetailDarkTextBlock}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LibraryWorkStepItemTemplate" DataType="{x:Type viewModel:LibraryLoaderWorkStepViewModel}">

        <Grid x:Name="Bg" RowDefinitions="Auto, Auto" ColumnDefinitions="30, 120, *" Background="Transparent">

            <TextBlock Grid.Column="0" 
                       Margin="0"
                       Text="{Binding StepNumber}" 
                       Style="{StaticResource LabelTextBlock}"  />

            <TextBlock Grid.Column="1" 
                       Margin="0"
                       Text="{Binding Result}" 
                       Style="{StaticResource LabelTextBlock}"  />

            <TextBlock Grid.Column="2" 
                       Text="{Binding Message}"                        
                       Margin="0"
                       Style="{StaticResource LabelDetailDarkTextBlock}" />
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Complete}" Value="False">
                <Setter Property="Background" TargetName="Bg" Value="{StaticResource WorkItemBackgroundError}" />
            </DataTrigger>
        </DataTemplate.Triggers>
        
    </DataTemplate>

</ResourceDictionary>