<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:treeViewUI="clr-namespace:SimpleWpf.UI.Controls.TreeViewUI;assembly=SimpleWpf.UI">

    <!-- Theme Brushes (TODO: put these in the primary theme resources after we're done styling) -->
    <SolidColorBrush x:Key="FileTreeItemHoverBackground">#0F33AAFF</SolidColorBrush>
    <SolidColorBrush x:Key="FileTreeItemSelectBackground">#2F33AAFF</SolidColorBrush>

    <Style x:Key="FileTreeViewItemStyle" TargetType="{x:Type treeViewUI:SimpleTreeView}">

        <Setter Property="BorderBrush" Value="LightGray" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemBackground" Value="AliceBlue" />
        <Setter Property="ItemBackgroundAlternation" Value="White" />
        <Setter Property="ItemBorder" Value="Transparent" />
        <Setter Property="ItemBorderThickness" Value="0" />
        <Setter Property="ItemHoverBrush" Value="{StaticResource FileTreeItemHoverBackground}" />
        <Setter Property="ItemSelectionBrush" Value="{StaticResource FileTreeItemSelectBackground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ItemIndent" Value="26" />
        <Setter Property="ItemPadding" Value="2" />

        <Setter Property="ItemExpanderOpenTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Background="Transparent">

                        <fa5:ImageAwesome Icon="Regular_FolderOpen"                                                     
                                          Style="{StaticResource FontAwesomeIconManagerViewPager}"
                                          Margin="3" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemExpanderClosedTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Background="Transparent">

                        <fa5:ImageAwesome Icon="Regular_Folder"                                                     
                                          Style="{StaticResource FontAwesomeIconManagerViewPager}"
                                          Margin="3" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>