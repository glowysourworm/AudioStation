<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:controls="clr-namespace:AudioStation.Controls"
                    xmlns:coreInterface="clr-namespace:AudioStation.Core.Component.Interface;assembly=AudioStation.Core">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/ThemeColorsAndBrushes.xaml" />
        <ResourceDictionary Source="/Resources/TextBlockStyles.xaml" />
        <ResourceDictionary Source="/Resources/ButtonStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Font Awesome Icon Styles -->
    <Style TargetType="{x:Type fa5:SvgAwesome}" x:Key="FontAwesomeIconDefault">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="Gray" />
    </Style>
    <Style TargetType="{x:Type Button}" x:Key="FontAwesomeStatusIcon">
        <Setter Property="Foreground" Value="#FFAAAAAA" />
        <Setter Property="BorderThickness" Value="0 0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border BorderThickness="{TemplateBinding BorderThickness}">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0.5, 0" EndPoint="0.5, 1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#FFAAAAAA" Offset="0.33" />
                                    <GradientStop Color="#FFAAAAAA" Offset="0.66" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <fa5:ImageAwesome x:Name="FaIcon"
                                          Icon="{TemplateBinding Tag}"
                                          Width="16"
                                          Height="16"
                                          Margin="5 2"
                                          Foreground="{TemplateBinding Foreground}"
                                          />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Mouse Over (True) (Disalbed) (Nothing Happens) -->
                        <!-- Mouse Over (True) (Idle) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="True" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Idle}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="#FF555555" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <!-- Mouse Over (True) (Working) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="True" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Working}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="DeepSkyBlue" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <!-- Mouse Over (True) (Error) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="True" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Error}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="Crimson"/>
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <!-- Mouse Over (False) (Disabled) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="False" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Disabled}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="#FFAAAAAA" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <!-- Mouse Over (False) (Idle) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="False" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Idle}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="Gray" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>


                        <!-- Mouse Over (False) (Working) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="False" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Working}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="{StaticResource ScrubberTimelinePlayedDefaultBrush}" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <!-- Mouse Over (False) (Error) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=FaIcon, Path=IsMouseOver}" Value="False" />
                                <Condition Binding="{Binding Status}" Value="{x:Static coreInterface:IAudioStationComponent+Status.Error}" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="Foreground" Value="Red" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>    
    <Style TargetType="{x:Type fa5:ImageAwesome}" x:Key="FontAwesomeIconManagerViewPager">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="#FFAAAAAA" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.Setters>
                    <Setter Property="Foreground" Value="#FF555555" />
                </Trigger.Setters>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type fa5:SvgAwesome}" x:Key="FontAwesomeIconControlPanelButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="Gray" />
    </Style>
    <Style TargetType="{x:Type fa5:SvgAwesome}" x:Key="FontAwesomeIconValidation">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="Red" />
    </Style>
    <!-- ************************ -->

    <Style x:Key="ScrubberControlDefaultStyle" TargetType="{x:Type controls:ScrubberControl}">
        <Setter Property="Background" Value="{StaticResource ScrubberBackgroundDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ScrubberBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrubberHandleBrush" Value="{StaticResource ScrubberHandleDefaultBrush}" />
        <Setter Property="ScrubberTimelineBrush" Value="{StaticResource ScrubberTimelineDefaultBrush}" />
        <Setter Property="ScrubberTimelineBrushScrubbed" Value="{StaticResource ScrubberTimelinePlayedDefaultBrush}" />
    </Style>

</ResourceDictionary>